 // Fill size of 2-words seems to work on a PS1, and even behaves as if the line size is 2 words in regards to clearing
 // the valid bits(when the tag matches, of course), but is obviously not very efficient unless running code that's just endless branching.
 //
+/* VBlank probe: where the processor's time goes, for a profiler. The cycles
+ * from one instruction's fetch to the next are added to the first one's
+ * address in main RAM (code outside it, the BIOS's, is counted at RAM's first
+ * word, where no program runs), stalls and waits included. Nothing is kept until the
+ * first time it is asked for. vblank_probe_profile_take hands over what was
+ * counted since it last was, each address (as 8xxxxxxxh) a little-endian
+ * word of 32 bits and its cycles one of 64. */
+#define VBLANK_PROBE_SLOTS (0x200000 >> 2)
+static uint64_t *vblank_probe_spent = NULL;
+static uint32_t *vblank_probe_touched = NULL;
+static uint32_t vblank_probe_touched_count = 0;
+static uint32_t vblank_probe_last_pc = 0;
+static int32_t vblank_probe_last_ts = 0;
+uint8_t *vblank_probe_profile_bytes = NULL;
+
+static INLINE void vblank_probe_count(uint32_t pc, int32_t ts)
+{
+   if (vblank_probe_spent && ts > vblank_probe_last_ts)
+   {
+      /* Main RAM is the first 2 MB of the physical addresses (KUSEG, KSEG0
+       * and KSEG1 alike); anything else, the BIOS above all, is slot 0. */
+      uint32_t physical = vblank_probe_last_pc & 0x1FFFFFFF;
+      uint32_t slot = physical < 0x200000 ? physical >> 2 : 0;
+      if (!vblank_probe_spent[slot])
+         vblank_probe_touched[vblank_probe_touched_count++] = slot;
+      vblank_probe_spent[slot] += (uint64_t)(ts - vblank_probe_last_ts);
+   }
+   vblank_probe_last_pc = pc;
+   vblank_probe_last_ts = ts;
+}
+
+/* Back to counting nothing, as at power-on. A library copy is used again by
+ * the next console that takes it, and its globals with it. */
+void vblank_probe_profile_reset(void)
+{
+   free(vblank_probe_spent);
+   free(vblank_probe_touched);
+   vblank_probe_spent = NULL;
+   vblank_probe_touched = NULL;
+   vblank_probe_touched_count = 0;
+   vblank_probe_last_pc = 0;
+   vblank_probe_last_ts = 0;
+}
+
+uint32_t vblank_probe_profile_take(void)
+{
+   uint32_t n, byte, size = vblank_probe_touched_count * 12;
+   if (!vblank_probe_spent)
+   {
+      vblank_probe_spent = (uint64_t*)calloc(VBLANK_PROBE_SLOTS, sizeof(*vblank_probe_spent));
+      vblank_probe_touched = (uint32_t*)calloc(VBLANK_PROBE_SLOTS, sizeof(*vblank_probe_touched));
+      return 0;
+   }
+   vblank_probe_profile_bytes = (uint8_t*)realloc(vblank_probe_profile_bytes, size + 12);
+   for (n = 0; n < vblank_probe_touched_count; n++)
+   {
+      uint32_t slot = vblank_probe_touched[n];
+      uint32_t address = 0x80000000 | (slot << 2);
+      uint64_t cycles = vblank_probe_spent[slot];
+      for (byte = 0; byte < 4; byte++) vblank_probe_profile_bytes[n * 12 + byte] = (uint8_t)(address >> (byte * 8));
+      for (byte = 0; byte < 8; byte++) vblank_probe_profile_bytes[n * 12 + 4 + byte] = (uint8_t)(cycles >> (byte * 8));
+      vblank_probe_spent[slot] = 0;
+   }
+   vblank_probe_touched_count = 0;
+   return size;
+}
