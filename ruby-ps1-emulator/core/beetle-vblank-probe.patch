+/* VBlank probe: the console's memories beyond main RAM, for a test reading
+ * back what a program did. VRAM as the GPU keeps it (1024x512 halfwords at
+ * the 1x internal resolution), the GPU's display and drawing settings, the
+ * scratchpad, and the CPU's registers. */
+#define VBLANK_PROBE_VRAM      0x8001
+#define VBLANK_PROBE_GPU       0x8002
+#define VBLANK_PROBE_SCRATCH   0x8003
+#define VBLANK_PROBE_CPU       0x8004
+/* Where the processor's time went since it was last asked, by address
+ * (cpu.c), and the cycles the graphics chip has spent drawing since power-on
+ * (gpu.c), a little-endian count of 64 bits. */
+#define VBLANK_PROBE_PROFILE   0x8007
+#define VBLANK_PROBE_GPU_BUSY  0x8008
+extern PS_GPU GPU;
+extern uint8_t *vblank_probe_profile_bytes;
+extern uint32_t vblank_probe_profile_take(void);
+extern uint64_t vblank_probe_gpu_busy;
+static uint32_t vblank_probe_gpu[16];
+static uint32_t vblank_probe_cpu[35];
+
+static void *vblank_probe_gpu_state(void)
+{
+   vblank_probe_gpu[0]  = GPU.DisplayMode;
+   vblank_probe_gpu[1]  = GPU.DisplayOff;
+   vblank_probe_gpu[2]  = GPU.DisplayFB_XStart;
+   vblank_probe_gpu[3]  = GPU.DisplayFB_YStart;
+   vblank_probe_gpu[4]  = GPU.HorizStart;
+   vblank_probe_gpu[5]  = GPU.HorizEnd;
+   vblank_probe_gpu[6]  = GPU.VertStart;
+   vblank_probe_gpu[7]  = GPU.VertEnd;
+   vblank_probe_gpu[8]  = (uint32_t)GPU.ClipX0;
+   vblank_probe_gpu[9]  = (uint32_t)GPU.ClipY0;
+   vblank_probe_gpu[10] = (uint32_t)GPU.ClipX1;
+   vblank_probe_gpu[11] = (uint32_t)GPU.ClipY1;
+   vblank_probe_gpu[12] = (uint32_t)GPU.OffsX;
+   vblank_probe_gpu[13] = (uint32_t)GPU.OffsY;
+   vblank_probe_gpu[14] = GPU.upscale_shift;
+   vblank_probe_gpu[15] = GPU.scanline;
+   return vblank_probe_gpu;
 }
 
+static void *vblank_probe_cpu_state(void)
+{
+   if (!PSX_CPU)
+      return NULL;
+   memcpy(vblank_probe_cpu, PSX_CPU->GPR_full, 34 * sizeof(uint32_t));
+   vblank_probe_cpu[34] = PSX_CPU->BACKED_PC;
+   return vblank_probe_cpu;
+}
