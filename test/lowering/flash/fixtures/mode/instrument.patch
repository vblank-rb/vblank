+		/**
+		 * Instrumentation for comparing a remake with this game: how many updates the replay has played,
+		 * and how many of them have been traced.
+		 */
+		protected var _instrumentUpdates:uint = 0;
+		protected var _instrumentTraced:uint = 0;
+		protected var _instrumentCrcTable:Vector.<uint>;
+		
+		/**
+		 * Traces "update N HASH" once for each update of a replay, after its picture is drawn: the CRC-32 of the
+		 * camera's picture with each pixel cut to 5 bits a channel and packed as the Game Boy Advance's 15-bit
+		 * colour (red lowest), each as two bytes, low byte first.
+		 */
+		protected function instrumentUpdate():void
+		{
+			if(_instrumentUpdates == _instrumentTraced)
+				return;
+			_instrumentTraced = _instrumentUpdates;
+			if(_instrumentCrcTable == null)
+			{
+				_instrumentCrcTable = new Vector.<uint>(256,true);
+				for(var n:uint = 0; n < 256; n++)
+				{
+					var c:uint = n;
+					for(var bit:uint = 0; bit < 8; bit++)
+						c = ((c & 1) != 0) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
+					_instrumentCrcTable[n] = c;
+				}
+			}
+			var picture:BitmapData = FlxG.camera.buffer;
+			var pixels:Vector.<uint> = picture.getVector(picture.rect);
+			var crc:uint = 0xFFFFFFFF;
+			var count:uint = pixels.length;
+			for(var i:uint = 0; i < count; i++)
+			{
+				var p:uint = pixels[i];
+				var word:uint = ((p >> 19) & 31) | (((p >> 11) & 31) << 5) | (((p >> 3) & 31) << 10);
+				crc = _instrumentCrcTable[(crc ^ word) & 0xFF] ^ (crc >>> 8);
+				crc = _instrumentCrcTable[(crc ^ (word >> 8)) & 0xFF] ^ (crc >>> 8);
+			}
+			crc = crc ^ 0xFFFFFFFF;
+			var hex:String = crc.toString(16);
+			while(hex.length < 8)
+				hex = "0" + hex;
+			trace("update " + _instrumentUpdates + " " + hex);
+		}
+		
+		/**
+		 * Called when the replay ends, by running out of frames or of time: says how many updates it played and
+		 * asks the player to stop.
+		 */
+		public function instrumentEnd():void
+		{
+			trace("end " + _instrumentUpdates);
+			fscommand("rg_exit","0:");
+		}
