# frozen_string_literal: true

require "rake/testtask"
require_relative "lib/ruby_snes_emulator/core_library"
require_relative "lib/ruby_snes_emulator/core_build"

# THE CORE: bsnes with the probe patch, built into core/build/bsnes_libretro.so. CoreBuild says what
# it is and how it is made, and `gem install vblank` makes it the same way. VBLANK_SNES_CORE points
# this code at a core built some other way.
BUILT = RubySNESEmulator::CoreLibrary::BUILT
PATCH = RubySNESEmulator::CoreBuild::PATCH

desc "Build bsnes as a libretro core, with the probe patch, into core/build/"
task :compile_core do
  next if File.file?(BUILT) && File.mtime(BUILT) > File.mtime(PATCH)

  RubySNESEmulator::CoreBuild.make(BUILT)
end

desc "Remove the built core"
task :clean do
  rm_rf File.dirname(BUILT)
end

Rake::TestTask.new(test: :compile_core) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/test_*.rb"]
  t.warning = false
end

task default: :test
