# frozen_string_literal: true

require "rake/testtask"
require "rbconfig"
require_relative "lib/ruby_genesis_emulator/built_for"
require_relative "lib/ruby_genesis_emulator/core_library"
require_relative "lib/ruby_genesis_emulator/core_build"

# THE CORE: Genesis Plus GX with the probe patch, built into core/build/genesis_plus_gx_libretro.so
# (kept under that name on a Mac too, where the build makes a .dylib). CoreBuild says what it is and how
# it is made. VBLANK_GENESIS_CORE points this code at a core built some other way.
BUILT = RubyGenesisEmulator::CoreLibrary::BUILT
PATCH = RubyGenesisEmulator::CoreBuild::PATCH

desc "Build Genesis Plus GX as a libretro core, with the probe patch, into core/build/"
task :compile_core do
  next if File.file?(BUILT) && File.mtime(BUILT) > File.mtime(PATCH)

  RubyGenesisEmulator::CoreBuild.make(BUILT)
end

# THE FRONTEND THE CORE IS PLAYED THROUGH: the gem's C extension (ext/ruby_genesis_emulator_ext/),
# built into lib/<the Ruby that built it>/ruby_genesis_emulator/ and installed there rather than into
# the Ruby itself, as ruby-gba-emulator's Rakefile does and says why. A file task, so it is built
# again only when it is missing for this Ruby or its source is newer.
#
# Every object is compiled again each time: the fingerprint of the source (BUILT_FROM) is a compiler
# flag of ruby_genesis_emulator_ext.c's, and make would keep that file's object when only
# libretro_frontend.c changed, leaving a build that calls itself out of date.
EXT_DIR = File.expand_path("ext/ruby_genesis_emulator_ext", __dir__)
INSTALL_DIR = File.expand_path("lib/#{RubyGenesisEmulator::BUILT_FOR}/ruby_genesis_emulator", __dir__)
EXT_BUNDLE = File.join(INSTALL_DIR, "ruby_genesis_emulator_ext.#{RbConfig::CONFIG['DLEXT']}")

file EXT_BUNDLE => FileList["#{EXT_DIR}/*.{c,h}", "#{EXT_DIR}/extconf.rb"] do
  mkdir_p INSTALL_DIR
  Dir.chdir(EXT_DIR) do
    ruby "extconf.rb"
    sh "make", "clean"
    sh "make"
    sh "make", "install-so", "RUBYARCHDIR=#{INSTALL_DIR}"
  end
end

desc "Build the C extension the core is played through, if its source changed"
task compile: EXT_BUNDLE

desc "Remove the built core and the built extension"
task :clean do
  rm_rf File.dirname(BUILT)
  rm_rf Dir.glob(File.expand_path("lib/[0-9]*", __dir__))
  Dir.chdir(EXT_DIR) do
    sh "make", "clean" if File.exist?("Makefile")
    rm_f Dir.glob("Makefile") + Dir.glob("*.#{RbConfig::CONFIG['DLEXT']}") + Dir.glob("*.o") + Dir.glob("mkmf.log")
  end
end

Rake::TestTask.new(test: %i[compile compile_core]) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/test_*.rb"]
  t.warning = false
end

task default: :test
