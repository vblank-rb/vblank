+extern unsigned char probe_fm_registers[0x200];
+
+static unsigned int probe_m68k_regs[18];
+
+static void probe_read_m68k_regs(void)
+{
+   int i;
+   for (i = 0; i < 8; i++)
+   {
+      probe_m68k_regs[i]     = m68k_get_reg(M68K_REG_D0 + i);
+      probe_m68k_regs[8 + i] = m68k_get_reg(M68K_REG_A0 + i);
+   }
+   probe_m68k_regs[16] = m68k_get_reg(M68K_REG_PC);
+   probe_m68k_regs[17] = m68k_get_reg(M68K_REG_SR);
+}
