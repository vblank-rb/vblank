diff --git a/core/sound/ym2612.c b/core/sound/ym2612.c
index 3cba674..f1b6272 100644
--- a/core/sound/ym2612.c
+++ b/core/sound/ym2612.c
@@ -1954,10 +1954,61 @@ void YM2612ResetChip(void)
 /* n = number  */
 /* a = address */
 /* v = value   */
+unsigned char probe_fm_registers[0x200]; /* THE PROBE PATCH: what each register was last told */
+
+/* THE PROBE PATCH: every write to the sound chips, for a probe that lists them. Nothing is logged until the
+   log is first taken (probe_sound_writes_take), so a run that never watches pays nothing. An entry is four
+   bytes: the chip (0 the PSG, 1 the FM chip), the register as a little-endian 16-bit number, and the value.
+   Past a million entries, writes are counted and not kept. */
+#include <stdlib.h>
+#include <string.h>
+#define PROBE_SOUND_ENTRIES (1 << 20)
+static unsigned char *probe_sound_log = NULL;
+static unsigned int probe_sound_count = 0;
+static unsigned int probe_sound_dropped = 0;
+unsigned char *probe_sound_writes_bytes = NULL;
+
+void probe_sound_write(unsigned int chip, unsigned int reg, unsigned int value)
+{
+  unsigned char *entry;
+  if (!probe_sound_log) return;
+  if (probe_sound_count >= PROBE_SOUND_ENTRIES) { probe_sound_dropped++; return; }
+  entry = probe_sound_log + probe_sound_count * 4;
+  entry[0] = chip;
+  entry[1] = reg & 0xff;
+  entry[2] = (reg >> 8) & 0xff;
+  entry[3] = value;
+  probe_sound_count++;
+}
+
+/* What was written since this was last asked: a 4-byte little-endian count of the writes dropped, then the
+   entries. The first ask starts the log and answers nothing. */
+unsigned int probe_sound_writes_take(void)
+{
+  unsigned int n, size;
+  if (!probe_sound_log)
+  {
+    probe_sound_log = malloc(PROBE_SOUND_ENTRIES * 4);
+    return 0;
+  }
+  size = 4 + probe_sound_count * 4;
+  probe_sound_writes_bytes = realloc(probe_sound_writes_bytes, size);
+  for (n = 0; n < 4; n++) probe_sound_writes_bytes[n] = probe_sound_dropped >> (n * 8);
+  memcpy(probe_sound_writes_bytes + 4, probe_sound_log, probe_sound_count * 4);
+  probe_sound_count = 0;
+  probe_sound_dropped = 0;
+  return size;
+}
+
 void YM2612Write(unsigned int a, unsigned int v)
 {
   v &= 0xff;  /* adjust to 8 bit bus */
 
+  if (a & 1) probe_fm_registers[ym2612.OPN.ST.address & 0x1ff] = v;
+  /* the DAC's sample (0x2A) and the timers (0x24 to 0x27) start no note, and a recording writes them every sample */
+  if ((a & 1) && ym2612.OPN.ST.address != 0x2a && (ym2612.OPN.ST.address < 0x24 || ym2612.OPN.ST.address > 0x27))
+    probe_sound_write(1, ym2612.OPN.ST.address & 0x1ff, v);
+
   switch( a )
   {
     case 0:  /* address port 0 */
