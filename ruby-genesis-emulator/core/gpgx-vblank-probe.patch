 #include "m68kconf.h"
 #include "m68kcpu.h"
 #include "m68kops.h"
+
+/* THE PROBE PATCH: where the 68000's time goes, for a profiler. Each instruction's cycles, in the
+   core's own count of seven to a processor cycle, are added to the address it started at. Nothing
+   is kept until the first time it is asked for. probe_profile_take hands over what was counted
+   since it last was, each address as a little-endian word of 32 bits and one of 64. */
+#include <stdlib.h>
+static unsigned long long *probe_spent = NULL;
+static unsigned int *probe_touched = NULL;
+static unsigned int probe_touched_count = 0;
+unsigned char *probe_profile_bytes = NULL;
+
+static void probe_profile_add(unsigned int address, unsigned int before)
+{
+  unsigned int cycles = m68k.cycles - before;
+  if (!probe_spent || !cycles) return;
+  address &= 0xffffff;
+  if (!probe_spent[address]) probe_touched[probe_touched_count++] = address;
+  probe_spent[address] += cycles;
+}
+
+unsigned int probe_profile_take(void)
+{
+  unsigned int n, byte, size = probe_touched_count * 12;
+  if (!probe_spent)
+  {
+    probe_spent = calloc(1 << 24, sizeof(*probe_spent));
+    probe_touched = calloc(1 << 24, sizeof(*probe_touched));
+    return 0;
+  }
+  probe_profile_bytes = realloc(probe_profile_bytes, size + 12);
+  for (n = 0; n < probe_touched_count; n++)
+  {
+    unsigned int address = probe_touched[n];
+    unsigned long long cycles = probe_spent[address];
+    for (byte = 0; byte < 4; byte++) probe_profile_bytes[n * 12 + byte] = address >> (byte * 8);
+    for (byte = 0; byte < 8; byte++) probe_profile_bytes[n * 12 + 4 + byte] = cycles >> (byte * 8);
+    probe_spent[address] = 0;
+  }
+  probe_touched_count = 0;
+  return size;
+}
 
