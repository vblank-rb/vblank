+/* VBlank probe: the frontend half. In the timing this harness asks for, the core hands each picture over
+   from the emulator's own stack (a coroutine, see GFX_EndUpdate), and Ruby cannot be called from a stack it
+   does not know. So the frontend is here: it answers the core's questions, and keeps what the harness reads
+   afterwards: the last picture and the sound made. Each copy of the library has its own.
+
+   The answers it gives are what make a frame exact. "dosbox_svn_core_timing" is "external": the machine
+   keeps no time by the host's clock, and each retro_run ends when the video card has finished one picture.
+   "dosbox_svn_use_options" is "false": the machine is what the configuration file says, and no core option
+   is laid over it. */
+#include <vector>
+#define VBLANK_EXPORT extern "C" __attribute__((visibility("default")))
+static const char* vblank_directory = ".";
+static std::vector<Bit32u> vblank_pixels;
+static unsigned vblank_picture_width, vblank_picture_height;
+static std::vector<int16_t> vblank_sound;
+static retro_keyboard_event_t vblank_keyboard_event;
+static void RETRO_CALLCONV vblank_log(enum retro_log_level, const char*, ...) { }
+VBLANK_EXPORT void vblank_set_directory(const char* path) { vblank_directory = path; }
+/* A key going down (1) or up (0), told to the core the way a frontend does: through the callback it asked for.
+
+   WHEN THE KEYBOARD HEARS OF IT. The harness presses keys between two frames, and a frame ends as the card
+   finishes the picture's last line, a few lines before the vertical retrace begins. A program reads its
+   keys as the retrace begins, and the keyboard takes about as long as those few lines to send one byte: a
+   key of one byte would be read in this frame and a key of two (an arrow) in the next. So the keys wait
+   until the retrace has ended, and reach the keyboard then: each has a whole frame to arrive, and all are
+   read at the next retrace, whichever key and however many. The keyboard's own timing is untouched. */
+static std::vector<std::pair<bool, unsigned> > vblank_keys_waiting;
+static void vblank_keys_reach_keyboard(Bitu)
+{
+    for (size_t i = 0; i != vblank_keys_waiting.size(); i++)
+        if (vblank_keyboard_event) vblank_keyboard_event(vblank_keys_waiting[i].first, vblank_keys_waiting[i].second, 0, 0);
+    vblank_keys_waiting.clear();
+}
+VBLANK_EXPORT void vblank_key_event(int down, unsigned code)
+{
+    /* From the picture's last line to the end of the retrace, in milliseconds; a card not drawing yet has none. */
+    float until_retrace_ends = (float)(vga.draw.delay.vrend - vga.draw.delay.vdend);
+    if (!(until_retrace_ends > 0)) until_retrace_ends = 1.0f;
+    if (vblank_keys_waiting.empty()) PIC_AddEvent(vblank_keys_reach_keyboard, until_retrace_ends);
+    vblank_keys_waiting.push_back(std::make_pair(down != 0, code));
+}
+VBLANK_EXPORT bool vblank_environment(unsigned cmd, void* data)
+{
+    switch (cmd)
+    {
+        case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT: return *(int*)data == RETRO_PIXEL_FORMAT_XRGB8888;
+        case RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY:
+        case RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY: *(const char**)data = vblank_directory; return true;
+        case RETRO_ENVIRONMENT_GET_VARIABLE:
+        {
+            struct retro_variable* variable = (struct retro_variable*)data;
+            if (!strcmp(variable->key, "dosbox_svn_core_timing")) { variable->value = "external"; return true; }
+            if (!strcmp(variable->key, "dosbox_svn_use_options")) { variable->value = "false"; return true; }
+            return false;
+        }
+        case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE: *(bool*)data = false; return true;
+        case RETRO_ENVIRONMENT_SET_KEYBOARD_CALLBACK: vblank_keyboard_event = ((struct retro_keyboard_callback*)data)->callback; return true;
+        case RETRO_ENVIRONMENT_GET_LOG_INTERFACE: ((struct retro_log_callback*)data)->log = vblank_log; return true;
+        case RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO:
+        case RETRO_ENVIRONMENT_SET_GEOMETRY: return true;
+    }
+    return false;
+}
+/* A picture the card finished. No data means it is the same as the one before, which is kept. */
+VBLANK_EXPORT void vblank_video_refresh(const void* data, unsigned width, unsigned height, size_t pitch)
+{
+    if (!data) return;
+    vblank_picture_width = width; vblank_picture_height = height;
+    vblank_pixels.resize((size_t)width * height);
+    for (unsigned y = 0; y != height; y++) memcpy(vblank_pixels.data() + (size_t)y * width, (const char*)data + y * pitch, (size_t)width * 4);
+}
+VBLANK_EXPORT size_t vblank_audio_batch(const int16_t* data, size_t frames)
+{
+    vblank_sound.insert(vblank_sound.end(), data, data + frames * 2);
+    return frames;
+}
+VBLANK_EXPORT void vblank_audio_sample(int16_t left, int16_t right) { int16_t pair[2] = { left, right }; vblank_audio_batch(pair, 1); }
+VBLANK_EXPORT void vblank_input_poll(void) { }
+/* No mouse and no joystick: the keyboard is told through vblank_key_event. */
+VBLANK_EXPORT int16_t vblank_input_state(unsigned, unsigned, unsigned, unsigned) { return 0; }
+/* Copies the last picture into +into+ when it has room for it (+room+ pixels), and says its size either
+   way; returns how many pixels the picture has, 0 before the first. */
+VBLANK_EXPORT size_t vblank_copy_picture(Bit32u* into, size_t room, unsigned* width, unsigned* height)
+{
+    *width = vblank_picture_width; *height = vblank_picture_height;
+    if (into && vblank_pixels.size() <= room && !vblank_pixels.empty()) memcpy(into, vblank_pixels.data(), vblank_pixels.size() * 4);
+    return vblank_pixels.size();
+}
+/* Copies out and forgets the sound made so far, as many 16-bit values as fit; returns how many it held. */
+VBLANK_EXPORT size_t vblank_take_sound(int16_t* into, size_t room)
+{
+    size_t held = vblank_sound.size(), taken = held < room ? held : room;
+    if (into && taken) memcpy(into, vblank_sound.data(), taken * 2);
+    vblank_sound.erase(vblank_sound.begin(), vblank_sound.begin() + taken);
+    return held;
+}
