+// VBlank probe: hands over the machine's memories to the test harness (see ruby-dos-emulator/core/dosbox-vblank-probe.patch).
+// System RAM is the first megabyte of the PC's address space; the others are named by the harness.
+#include "include/vga.h"
+enum { VBLANK_VIDEO_RAM = 0x8001, VBLANK_PALETTE = 0x8002, VBLANK_VGA_STATE = 0x8003 };
+static Bit32u vblank_vga_state[4];
+void *retro_get_memory_data(unsigned id)
+{
+	switch (id)
+	{
+		case RETRO_MEMORY_SYSTEM_RAM: return MemBase;
+		case VBLANK_VIDEO_RAM: return vga.mem.linear;
+		case VBLANK_PALETTE: return vga.dac.rgb;
+		case VBLANK_VGA_STATE:
+			vblank_vga_state[0] = (Bit32u)vga.mode; vblank_vga_state[1] = (Bit32u)vga.draw.width;
+			vblank_vga_state[2] = (Bit32u)vga.draw.height; vblank_vga_state[3] = (Bit32u)vga.draw.address_add;
+			return vblank_vga_state;
+	}
+	return NULL;
+}
+size_t retro_get_memory_size(unsigned id)
+{
+	switch (id)
+	{
+		case RETRO_MEMORY_SYSTEM_RAM: return 0x100000;
+		case VBLANK_VIDEO_RAM: return vga.mem.linear ? vga.vmemsize : 0;
+		case VBLANK_PALETTE: return sizeof(vga.dac.rgb);
+		case VBLANK_VGA_STATE: return sizeof(vblank_vga_state);
+	}
+	return 0;
+}
